# ============================================================
# Illusion Dashboard - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains secrets
# ============================================================

# ── Dhan HQ API Credentials ──
# Get these from: https://dhanhq.co/docs/v2/
DHAN_CLIENT_ID="your_dhan_client_id"
DHAN_API_KEY="your_permanent_api_key_from_dhan_portal"
DHAN_API_SECRET="your_api_secret_from_dhan_portal"

# ── Access Token (Choose one method) ──
# Method 1: Manual token + auto-renewal (Recommended)
# DHAN_ACCESS_TOKEN="your_24h_access_token_from_web"

# Method 2: Fully automatic with TOTP (Requires TOTP setup)
# DHAN_PIN="your_6_digit_dhan_pin"
# DHAN_TOTP_SECRET="your_totp_secret_from_authenticator_app"

# ── Telegram Bot (Optional) ──
# For trade notifications and alerts
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# ── Production Settings ──
# Set to 'production' for deployment
APP_ENV="development"
# Database URL for production (SQLite by default)
# DATABASE_URL="sqlite:///data/trades.db"

# ── Server Configuration ──
# HOST="0.0.0.0"  # For production deployment
# PORT="8000"

# ── Logging ──
# LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR